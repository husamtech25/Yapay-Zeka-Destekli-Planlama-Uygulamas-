rules_version = '2';

// AYVEX Firestore güvenlik kuralları
// Her kullanıcı yalnızca kendi belgesine (users/{uid}) erişebilir.
// E-posta/şifre hesapları e-postalarını doğrulamadan erişemez (Google hesapları zaten doğrulanmış sayılır).
// Bu dosya Firebase konsolundaki Firestore > Rules sekmesine yapıştırılarak yayınlanır.
service cloud.firestore {
  match /databases/{database}/documents {

    function dogrulanmis() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      function sahibi() {
        return dogrulanmis() && request.auth.uid == uid;
      }
      function gecerliBelge() {
        let d = request.resource.data;
        return d.keys().hasOnly(['veri', 'ad', 'tur', 'surum', 'guncelleme'])
          && d.veri is string && d.veri.size() < 900000
          && d.ad is string && d.ad.size() <= 80
          && d.tur in ['student', 'work']
          && d.surum is int
          && d.guncelleme == request.time;
      }

      allow read, delete: if sahibi();
      allow create, update: if sahibi() && gecerliBelge();
    }

    // Salt okunur paylaşım bağlantıları (ör. bir projenin özeti).
    // Bağlantıyı (uzun, rastgele id) bilen herkes tek belgeyi okuyabilir; listeleme kapalı.
    // Sadece paylaşımı oluşturan kullanıcı güncelleyebilir ya da silebilir.
    match /paylasimlar/{id} {
      function gecerliPaylasim() {
        let d = request.resource.data;
        return d.keys().hasOnly(['sahip', 'tur', 'baslik', 'veri', 'guncelleme'])
          && d.sahip == request.auth.uid
          && d.tur in ['proje']
          && d.baslik is string && d.baslik.size() <= 120
          && d.veri is string && d.veri.size() < 200000
          && d.guncelleme == request.time
          && id.size() >= 20;
      }

      allow get: if true;
      allow list: if false;
      allow create: if dogrulanmis() && gecerliPaylasim();
      allow update: if dogrulanmis() && resource.data.sahip == request.auth.uid && gecerliPaylasim();
      allow delete: if dogrulanmis() && resource.data.sahip == request.auth.uid;
    }

    // Diğer her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
